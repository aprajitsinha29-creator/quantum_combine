# App
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/pathfinder.db
CORS_ORIGINS=http://localhost:5173
ADMIN_TOKEN=change-me

# SerpApi (Phase 1)
SERPAPI_API_KEY=
SERPAPI_USE_FIXTURES=false
SERPAPI_DAILY_CALL_CAP=60
SERPAPI_JOBS_MAX_PAGES=3

# Gemini (Phase 2)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_REQUESTS_PER_MINUTE=9

# Scheduler (Phase 5)
SCHEDULER_ENABLED=false
JOBS_DAILY_CRON="0 3 * * *"
JOBS_INDIA_WEEKLY_CRON="0 4 * * 1"
SCHOLAR_WEEKLY_CRON="0 5 * * 1"

# Quiz / Demo
# true while Phase 3 is built against placeholder questions; the owner flips
# this back to false once every question in quiz_questions.json is verified (M-08).
ALLOW_UNVERIFIED_QUESTIONS=false
DEMO_MODE=false
